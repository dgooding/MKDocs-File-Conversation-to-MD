{
  "name": "Docs to Markdown",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install uv && uv sync --extra test",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Docs to Markdown",
      "onAutoForward": "openBrowser"
    }
  }
}